{
  "name": "vue2-to-vue3-preflight",
  "version": "0.1.0",
  "private": true,
  "description": "Vue2toVue3：前置分析 + 可插拔迁移流水线",
  "bin": {
    "v23-analyze": "./bin/analyze.js",
    "v23-pipeline": "./bin/pipeline.js",
    "v23-run": "./bin/run.js",
    "v23-scaffold": "./bin/scaffold.js",
    "v23-ingest": "./bin/ingest.js",
    "v23-todos": "./bin/todos.js",
    "v23-check-refs": "./bin/check-refs.js",
    "v23-check-syntax": "./bin/check-syntax.js",
    "v23-migrate": "./bin/migrate.js"
  },
  "scripts": {
    "analyze": "node ./bin/analyze.js",
    "analyze:demo": "node ./bin/analyze.js ../my-vue-app",
    "pipeline": "node ./bin/pipeline.js",
    "pipeline:demo": "node ./bin/pipeline.js ../my-vue-app",
    "pipeline:list": "node ./bin/pipeline.js --list",
    "run:demo": "node ./bin/run.js ../my-vue-app",
    "run:pure": "node ./bin/run.js ../1.pure-vue-app --keep --write",
    "analyze:pure": "node ./bin/analyze.js ../1.pure-vue-app",
    "scaffold": "node ./bin/scaffold.js",
    "ingest": "node ./bin/ingest.js",
    "todos:pure": "node ./bin/todos.js ../1.pure-vue-app",
    "check-refs:pure": "node ./bin/check-refs.js ../1.pure-vue-app --all",
    "migrate": "node ./bin/migrate.js",
    "test:render": "node ./test/render-h.test.js",
    "test:render:stress": "node ./test/render-h.stress.js --rounds 10 --synth 100",
    "test:render:stress:heavy": "node ./test/render-h.stress.js --rounds 20 --synth 300",
    "test:html-migrate": "node ./test/html-migrate.test.js",
    "test:extend-mount": "node ./test/extend-mount.test.js",
    "test:syntax": "node ./scripts/check-syntax.js --self-test",
    "test:api-compat": "node ./test/api-compat.test.js",
    "test:functional": "node ./test/functional.test.js",
    "test:handoff": "node ./test/handoff-filters.test.js",
    "test:options-composition": "node ./test/options-composition.test.js",
    "test:instance-events": "node ./test/instance-events.test.js",
    "test:async-component": "node ./test/async-component.test.js",
    "test:typescript-carry": "node ./test/typescript-carry.test.js",
    "test:ingest-rewrite": "node ./test/ingest-rewrite.test.js",
    "test:options-plain-js": "node ./test/options-plain-js.test.js",
    "test:router": "node ./test/router.test.js",
    "test:dynamic-import": "node ./test/dynamic-import.test.js",
    "test:no-inplace-write": "node ./test/no-inplace-write.test.js",
    "test:auto": "npm run test:html-migrate && npm run test:extend-mount && npm run test:syntax && npm run test:render && npm run test:api-compat && npm run test:functional && npm run test:handoff && npm run test:options-composition && npm run test:instance-events && npm run test:async-component && npm run test:typescript-carry && npm run test:ingest-rewrite && npm run test:options-plain-js && npm run test:router && npm run test:dynamic-import && npm run test:no-inplace-write",
    "test:stress": "node ./test/auto-migrate.stress.js --rounds 12 --synth 120",
    "test:stress:heavy": "node ./test/auto-migrate.stress.js --rounds 20 --synth 300",
    "test:stress:functional": "node ./test/functional.stress.js --rounds 15 --synth 150",
    "test:stress:functional:heavy": "node ./test/functional.stress.js --rounds 20 --synth 300",
    "clean": "node ./bin/run.js ../my-vue-app --clean-only",
    "clean:pure": "node ./bin/run.js ../1.pure-vue-app --clean-only"
  },
  "dependencies": {
    "@babel/generator": "^7.29.15",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@vue/compiler-sfc": "^2.7.16",
    "fast-glob": "^3.3.2"
  }
}
